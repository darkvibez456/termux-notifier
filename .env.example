# ── termux-notifier credentials ─────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Telegram Bot Token (from @BotFather)
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Chat ID (from @userinfobot or getUpdates API)
TG_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Discord Webhook URL (Server Settings → Integrations → Webhooks)
DC_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
